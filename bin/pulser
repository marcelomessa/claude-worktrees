#!/bin/bash
# =============================================================================
# PULSER - Monitor Claude agents and send commands when idle
# =============================================================================

SESSION_NAME="claude-wt"
INTERVAL="${PULSER_INTERVAL:-30}"
IDLE_THRESHOLD="${IDLE_THRESHOLD:-60}"
LOG_FILE="/tmp/claude-wt.log"
CONFIG_FILE="/tmp/claude-wt-config.json"

log() {
  echo "[$(date '+%H:%M:%S')] $*" >> "$LOG_FILE"
}

> "$LOG_FILE"
log "Pulser iniciado - interval: ${INTERVAL}s, threshold: ${IDLE_THRESHOLD}s"

# Extract datetime from screen content
extract_datetime() {
  echo "$1" | grep -oE '\[[0-9]{2}:[0-9]{2}:[0-9]{2}\]' | tail -1 | tr -d '[]'
}

# Calculate seconds since time
seconds_since() {
  local time_str="$1"
  [[ -z "$time_str" ]] && echo "999999" && return

  local now=$(date '+%H:%M:%S')
  local now_sec=$(date -j -f '%H:%M:%S' "$now" '+%s' 2>/dev/null)
  local then_sec=$(date -j -f '%H:%M:%S' "$time_str" '+%s' 2>/dev/null)

  [[ -z "$now_sec" || -z "$then_sec" ]] && echo "999999" && return

  local diff=$((now_sec - then_sec))
  [[ $diff -lt 0 ]] && diff=$((diff + 86400))
  echo "$diff"
}

# Check a window for idle state
check_window() {
  local window_num="$1"
  local window_name="$2"

  local tmpfile="/tmp/screen-capture-$window_num.txt"
  screen -S "$SESSION_NAME" -p "$window_num" -X hardcopy "$tmpfile" 2>/dev/null
  [[ ! -f "$tmpfile" ]] && return 1

  local content=$(cat "$tmpfile")
  rm -f "$tmpfile"

  local last_time=$(extract_datetime "$content")
  local idle_secs=$(seconds_since "$last_time")

  # Check if waiting for input
  local waiting=false
  echo "$content" | tail -5 | grep -qE '^[>›»]|Human:|You:' && waiting=true

  log "  [$window_num] $window_name: time=$last_time, idle=${idle_secs}s, waiting=$waiting"

  # Send act if idle and waiting
  if [[ "$waiting" == "true" && $idle_secs -gt $IDLE_THRESHOLD ]]; then
    log "  -> Sending 'act' to $window_name"
    screen -S "$SESSION_NAME" -p "$window_num" -X stuff "act"$'\n'
  fi
}

# Main loop
while true; do
  if ! screen -list | grep -q "$SESSION_NAME"; then
    log "Session not found. Exiting."
    exit 1
  fi

  log "Verificando windows..."

  # Get workers from config
  if [[ -f "$CONFIG_FILE" ]]; then
    workers=$(jq -r '.workers[]' "$CONFIG_FILE" 2>/dev/null)
    window_num=2  # Start after coord(0) and qa(1)
    for worker in $workers; do
      check_window "$window_num" "$worker"
      ((window_num++))
    done
  fi

  log "Aguardando ${INTERVAL}s..."
  sleep "$INTERVAL"
done
