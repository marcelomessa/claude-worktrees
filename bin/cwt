#!/bin/bash
# =============================================================================
# CWT - Claude WorkTrees (tmux version)
# =============================================================================
# Uso:
#   cwt init                      # Inicializa projeto CWT
#   cwt front back sec            # Inicia com workers
#   cwt -c front back             # Resume sessões (--continue)
#   cwt --list                    # Lista sessões
#   cwt --kill                    # Encerra sessão
# =============================================================================

# Resolver symlinks para encontrar o diretório real do script
resolve_symlink() {
  local target="$1"
  # macOS não tem readlink -f, então fazemos manualmente
  while [[ -L "$target" ]]; do
    local dir=$(dirname "$target")
    target=$(readlink "$target")
    # Se o target é relativo, resolver a partir do diretório
    [[ "$target" != /* ]] && target="$dir/$target"
  done
  echo "$target"
}

SCRIPT_PATH=$(resolve_symlink "$0")
CWT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

# Detectar .cwt/ subindo a árvore de diretórios
find_cwt_root() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -d "$dir/.cwt" ]]; then
      echo "$dir"
      return 0
    fi
    dir=$(dirname "$dir")
  done
  return 1
}

# Nome da sessão baseado no projeto
get_session_name() {
  local cwt_root=$(find_cwt_root)
  if [[ -n "$cwt_root" ]]; then
    local project_name=$(basename "$cwt_root")
    echo "cwt-$project_name"
  else
    echo "cwt"
  fi
}

SESSION_NAME=$(get_session_name)

print_help() {
  cat << 'EOF'
CWT - Claude WorkTrees (tmux)

Uso: cwt [COMANDO] [OPÇÕES] [worker1] [worker2] ...

Comandos:
  init [OPÇÕES]        Inicializa projeto CWT
    --name, -n NAME    Nome do projeto
    --repo, -r REPO    Diretório do repo coordenador
  update               Atualiza settings/hooks do projeto

Opções:
  -h, --help       Mostra esta ajuda
  -c, --continue   Resume sessões Claude anteriores
  -b, --base       Branch base do coordenador (para merges)
  -l, --list       Lista sessões ativas
  -a, --list-all   Lista TODAS as sessões CWT (todos projetos)
  -k, --kill       Encerra sessão do projeto atual
  -s, --status     Mostra status dos workers

Estrutura de Projeto:
  ~/projects/meu-projeto/
  ├── .cwt/              # Criado por 'cwt init'
  ├── meu-repo/          # Coordenador (repo principal)
  ├── workspace-front/   # Worker (worktree)
  └── workspace-back/    # Worker (worktree)

Fluxo de Trabalho:
  # Opção 1: De dentro do repo
  cd meu-repo/
  cwt init                    # Detecta repo automaticamente
  wt-init front back          # Cria worktrees

  # Opção 2: De pasta de trabalho
  cd minha-pasta/
  git clone <url> meu-repo
  cwt init --repo meu-repo    # Especifica coordenador
  cd meu-repo && wt-init front back

  # Iniciar sessão
  cwt                         # Detecta coord e worktrees

Atalhos tmux:
  Ctrl+b n       Próxima window
  Ctrl+b p       Window anterior
  Ctrl+b 0-9     Ir para window N
  Ctrl+b d       Desconectar (continua rodando)
EOF
}

# Comando update - atualiza projeto existente com nova versão
cwt_update() {
  local cwt_root=$(find_cwt_root)
  local install_dir="$HOME/.claude-worktrees"

  if [[ -z "$cwt_root" ]]; then
    echo "❌ Nenhum projeto CWT encontrado"
    echo "   Execute 'cwt init' primeiro"
    exit 1
  fi

  echo "═══════════════════════════════════════"
  echo " CWT Update: $(basename "$cwt_root")"
  echo "═══════════════════════════════════════"

  # Ler config
  local config_file="$cwt_root/.cwt/config.json"
  local coordinator=$(jq -r '.coordinator // empty' "$config_file" 2>/dev/null)

  # Atualizar coordinator
  if [[ -n "$coordinator" && -d "$cwt_root/$coordinator" ]]; then
    echo ""
    echo "📦 Coordinator: $coordinator"
    local claude_dir="$cwt_root/$coordinator/.claude"
    mkdir -p "$claude_dir"

    # settings.json
    if [[ -f "$install_dir/templates/settings.coord.json" ]]; then
      cp "$install_dir/templates/settings.coord.json" "$claude_dir/settings.json"
      echo "   ✅ settings.json atualizado"
    fi

    # Symlinks para hooks
    ln -sf "$install_dir/hooks/wt-check.sh" "$claude_dir/wt-check.sh"
    ln -sf "$install_dir/hooks/wt-sync.sh" "$claude_dir/wt-sync.sh"
    echo "   ✅ hooks symlinks atualizados"
  fi

  # Atualizar workers
  local workers_file="$cwt_root/.cwt/workers.txt"
  if [[ -f "$workers_file" ]]; then
    while IFS= read -r worker_path; do
      [[ -z "$worker_path" || ! -d "$worker_path" ]] && continue

      local worker_name=$(basename "$worker_path")
      echo ""
      echo "📦 Worker: $worker_name"
      local claude_dir="$worker_path/.claude"
      mkdir -p "$claude_dir"

      # settings.json com WORKER_ID correto
      if [[ -f "$install_dir/templates/settings.worker.json" ]]; then
        sed "s/WORKER_NAME/$worker_name/g" "$install_dir/templates/settings.worker.json" > "$claude_dir/settings.json"
        echo "   ✅ settings.json atualizado (WORKER_ID: $worker_name)"
      fi

      # Symlinks para hooks
      ln -sf "$install_dir/hooks/wt-check.sh" "$claude_dir/wt-check.sh"
      ln -sf "$install_dir/hooks/wt-sync.sh" "$claude_dir/wt-sync.sh"
      echo "   ✅ hooks symlinks atualizados"
    done < "$workers_file"
  fi

  echo ""
  echo "═══════════════════════════════════════"
  echo " ✅ Projeto atualizado"
  echo "═══════════════════════════════════════"
}

# Comando init
cwt_init() {
  local project_name=""
  local coordinator=""

  # Parse args do init
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name|-n)
        project_name="$2"
        shift 2
        ;;
      --repo|-r)
        coordinator="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  # Default: nome do diretório atual
  [[ -z "$project_name" ]] && project_name=$(basename "$PWD")

  # Verificar se já existe
  if [[ -d ".cwt" ]]; then
    echo "⚠️  Projeto CWT já inicializado neste diretório"
    echo "   Config: .cwt/config.json"
    cat .cwt/config.json 2>/dev/null
    exit 1
  fi

  # Se não especificou coordenador, tentar detectar
  if [[ -z "$coordinator" ]]; then
    # Verificar se estamos dentro de um repo git
    if git rev-parse --git-dir &>/dev/null; then
      # Estamos em um repo - usar o nome do diretório atual
      coordinator=$(basename "$PWD")
      echo "ℹ️  Detectado repo git: $coordinator"
    fi
  fi

  # Criar estrutura
  mkdir -p .cwt

  cat > .cwt/config.json << EOF
{
  "name": "$project_name",
  "coordinator": "$coordinator",
  "created": "$(date -Iseconds)",
  "type": "project"
}
EOF

  echo '{"workers":{},"messages":[]}' > .cwt/state.json

  echo "═══════════════════════════════════════"
  echo " ✅ Projeto CWT inicializado"
  echo "═══════════════════════════════════════"
  echo " Nome:    $project_name"
  echo " Sessão:  cwt-$project_name"
  if [[ -n "$coordinator" ]]; then
    echo " Coord:   $coordinator"
  fi
  echo " Config:  .cwt/config.json"
  echo " Estado:  .cwt/state.json"
  echo "═══════════════════════════════════════"
  echo ""
  if [[ -z "$coordinator" ]]; then
    echo "Próximos passos:"
    echo "  1. Clone o repo: git clone <url> <nome>"
    echo "  2. Configure:    cwt config --repo <nome>"
    echo "  3. Worktrees:    cd <nome> && wt-init worker1 worker2"
    echo "  4. Inicie:       cwt"
  else
    echo "Próximos passos:"
    echo "  1. Crie worktrees: wt-init worker1 worker2"
    echo "  2. Inicie: cwt"
  fi
  echo ""
}

# Parse arguments
CONTINUE_FLAG=""
WORKERS=()

# Primeiro argumento pode ser comando
case "${1:-}" in
  init)
    shift
    cwt_init "$@"
    exit 0
    ;;
  update)
    shift
    cwt_update "$@"
    exit 0
    ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      print_help
      exit 0
      ;;
    -l|--list)
      echo "═══ Sessão do projeto atual ═══"
      tmux list-sessions 2>/dev/null | grep "^$SESSION_NAME" || echo "Nenhuma sessão ativa para: $SESSION_NAME"
      exit 0
      ;;
    -a|--list-all)
      echo "═══ Todas as sessões CWT ═══"
      tmux list-sessions 2>/dev/null | grep "^cwt" || echo "Nenhuma sessão CWT ativa"
      exit 0
      ;;
    -k|--kill)
      if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
        tmux kill-session -t "$SESSION_NAME"
        echo "Sessão '$SESSION_NAME' encerrada"
        pkill -f "tmux-pulser.sh" 2>/dev/null
      else
        echo "Sessão '$SESSION_NAME' não existe"
      fi
      exit 0
      ;;
    -s|--status)
      if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
        echo "═══ CWT: $SESSION_NAME ═══"
        tmux list-windows -t "$SESSION_NAME" -F "  #I: #W"
      else
        echo "Sessão '$SESSION_NAME' não está rodando"
      fi
      exit 0
      ;;
    -c|--continue)
      CONTINUE_FLAG="--continue"
      shift
      ;;
    -b|--base)
      export BASE_BRANCH="$2"
      shift 2
      ;;
    -*)
      echo "Opção desconhecida: $1"
      echo "Use 'cwt --help' para ver opções"
      exit 1
      ;;
    *)
      WORKERS+=("$1")
      shift
      ;;
  esac
done

# Se sessão existe e não passou workers, reconecta
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  if [[ ${#WORKERS[@]} -eq 0 ]]; then
    exec tmux attach -t "$SESSION_NAME"
  else
    echo "Sessão '$SESSION_NAME' já existe."
    echo "Use: cwt --kill  para encerrar"
    echo "Ou:  cwt         para reconectar"
    exit 1
  fi
fi

# Iniciar nova sessão
export CONTINUE_FLAG
export SESSION_NAME
export CWT_PROJECT_ROOT=$(find_cwt_root)
exec "$CWT_DIR/tmux-launcher.sh" "${WORKERS[@]}"
