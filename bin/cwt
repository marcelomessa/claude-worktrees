#!/bin/bash
# =============================================================================
# CWT - Claude WorkTrees (tmux version)
# =============================================================================
# Uso:
#   cwt front back sec           # Inicia com workers
#   cwt -c front back            # Resume sessões (--continue)
#   cwt --list                   # Lista sessões
#   cwt --kill                   # Encerra sessão
# =============================================================================

CWT_DIR="$(cd "$(dirname "$0")" && pwd)"
SESSION_NAME="cwt"

print_help() {
  cat << 'EOF'
CWT - Claude WorkTrees (tmux)

Uso: cwt [OPÇÕES] [worker1] [worker2] ...

Inicia sessão tmux com coordinator + workers.
Coordinator na window 0, workers nas seguintes.

Opções:
  -h, --help       Mostra esta ajuda
  -c, --continue   Resume sessões Claude anteriores
  -b, --base       Branch base do coordenador (para merges)
  -l, --list       Lista sessões ativas
  -k, --kill       Encerra sessão
  -s, --status     Mostra status dos workers

Exemplos:
  cwt front back sec           # 3 workers
  cwt -c front back            # Resume sessões
  cwt                          # Detecta worktrees automaticamente

Atalhos tmux:
  Ctrl+b n       Próxima window
  Ctrl+b p       Window anterior
  Ctrl+b 0-9     Ir para window N
  Ctrl+b d       Desconectar (continua rodando)

Mouse/Trackpad:
  Scroll         Navega pelo histórico (scrollback)
  Click          Seleciona pane/window
  q ou Esc       Sai do modo scroll
EOF
}

# Parse arguments
CONTINUE_FLAG=""
WORKERS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      print_help
      exit 0
      ;;
    -l|--list)
      tmux list-sessions 2>/dev/null | grep cwt || echo "Nenhuma sessão ativa"
      exit 0
      ;;
    -k|--kill)
      if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
        tmux kill-session -t "$SESSION_NAME"
        echo "Sessão '$SESSION_NAME' encerrada"
        pkill -f "tmux-pulser.sh" 2>/dev/null
      else
        echo "Sessão '$SESSION_NAME' não existe"
      fi
      exit 0
      ;;
    -s|--status)
      if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
        echo "═══ CWT WINDOWS ═══"
        tmux list-windows -t "$SESSION_NAME" -F "  #I: #W"
      else
        echo "Sessão não está rodando"
      fi
      exit 0
      ;;
    -c|--continue)
      CONTINUE_FLAG="--continue"
      shift
      ;;
    -b|--base)
      export BASE_BRANCH="$2"
      shift 2
      ;;
    -*)
      echo "Opção desconhecida: $1"
      echo "Use 'cwt --help' para ver opções"
      exit 1
      ;;
    *)
      WORKERS+=("$1")
      shift
      ;;
  esac
done

# Se sessão existe e não passou workers, reconecta
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  if [[ ${#WORKERS[@]} -eq 0 ]]; then
    exec tmux attach -t "$SESSION_NAME"
  else
    echo "Sessão '$SESSION_NAME' já existe."
    echo "Use: cwt --kill  para encerrar"
    echo "Ou:  cwt         para reconectar"
    exit 1
  fi
fi

# Iniciar nova sessão
export CONTINUE_FLAG
exec "$CWT_DIR/tmux-launcher.sh" "${WORKERS[@]}"
