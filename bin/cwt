#!/bin/bash
# =============================================================================
# CWT - Claude WorkTrees (tmux version)
# =============================================================================
# Usage:
#   cwt init                      # Initialize CWT project
#   cwt front back sec            # Start with workers
#   cwt -c front back             # Resume sessions (--continue)
#   cwt --list                    # List sessions
#   cwt --kill                    # Kill session
# =============================================================================

# Resolve symlinks to find the real script directory
resolve_symlink() {
  local target="$1"
  # macOS doesn't have readlink -f, so we do it manually
  while [[ -L "$target" ]]; do
    local dir=$(dirname "$target")
    target=$(readlink "$target")
    # If target is relative, resolve from the directory
    [[ "$target" != /* ]] && target="$dir/$target"
  done
  echo "$target"
}

SCRIPT_PATH=$(resolve_symlink "$0")
CWT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
CWT_INSTALL_DIR="$(dirname "$CWT_DIR")"
CWT_VERSION=$(cat "$CWT_INSTALL_DIR/VERSION" 2>/dev/null || echo "unknown")

# Detect .cwt/ by walking up the directory tree
find_cwt_root() {
  local dir="$PWD"
  while [[ "$dir" != "/" && "$dir" != "$HOME" ]]; do
    if [[ -d "$dir/.cwt" ]]; then
      echo "$dir"
      return 0
    fi
    dir=$(dirname "$dir")
  done
  return 1
}

# Session name based on project.
# Prefers .cwt/config.json "name" (set by `cwt init --name`) so that two
# projects sharing a directory basename can still be told apart.
get_session_name() {
  local cwt_root=$(find_cwt_root)
  [[ -z "$cwt_root" ]] && { echo "cwt"; return; }

  local name=$(jq -r '.name // empty' "$cwt_root/.cwt/config.json" 2>/dev/null)
  echo "cwt-${name:-$(basename "$cwt_root")}"
}

SESSION_NAME=$(get_session_name)

print_help() {
  cat << 'EOF'
CWT - Claude WorkTrees (tmux)

Usage: cwt [COMMAND] [OPTIONS] [worker1] [worker2] ...

Commands:
  init [OPTIONS]       Initialize CWT project
    --name, -n NAME    Project name
    --repo, -r REPO    Coordinator repo directory
  update               Update project settings/hooks

Options:
  -h, --help       Show this help
  -v, --version    Show installed version
  -c, --continue   Resume last Claude session in each worktree
  -r, --resume     Open picker to choose Claude session
  -b, --base       Coordinator base branch (for merges)
  -l, --list       List active sessions
  -a, --list-all   List ALL CWT sessions (all projects)
  -k, --kill       Kill current project session
  -s, --status     Show worker status
  --solo           Solo mode: coordinator only, no workers
  --strict         Strict mode: coordinator cannot edit code
  --session NAME   CWT session name (for coordinated resume)
  --sessions       List saved CWT sessions

Project Structure:
  ~/projects/my-project/
  ├── .cwt/              # Created by 'cwt init'
  ├── my-repo/           # Coordinator (main repo)
  ├── workspace-front/   # Worker (worktree)
  └── workspace-back/    # Worker (worktree)

Workflow:
  # Option 1: From inside the repo
  cd my-repo/
  cwt init                    # Auto-detects repo
  wt-init front back          # Create worktrees

  # Option 2: From working directory
  cd my-folder/
  git clone <url> my-repo
  cwt init --repo my-repo     # Specify coordinator
  cd my-repo && wt-init front back

  # Start session
  cwt                         # Detects coord and worktrees

Tmux shortcuts:
  Ctrl+b n       Next window
  Ctrl+b p       Previous window
  Ctrl+b 0-9     Go to window N
  Ctrl+b d       Detach (keeps running)
EOF
}

# Budget command - manage project budget
cwt_budget() {
  local cwt_root=$(find_cwt_root)

  if [[ -z "$cwt_root" ]]; then
    echo "❌ No CWT project found"
    exit 1
  fi

  local config_file="$cwt_root/.cwt/config.json"
  local limit=""
  local period=""
  local threshold=""
  local disable=false
  local show_status=true

  # Parse args
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --limit|-l)
        limit="$2"
        show_status=false
        shift 2
        ;;
      --period|-p)
        period="$2"
        show_status=false
        shift 2
        ;;
      --threshold|-t)
        threshold="$2"
        show_status=false
        shift 2
        ;;
      --disable)
        disable=true
        show_status=false
        shift
        ;;
      *)
        shift
        ;;
    esac
  done

  # Ensure config exists
  if [[ ! -f "$config_file" ]]; then
    echo '{"name": "'$(basename "$cwt_root")'"}' > "$config_file"
  fi

  # Disable budget
  if [[ "$disable" == "true" ]]; then
    jq 'del(.budget)' "$config_file" > "$config_file.tmp" && mv "$config_file.tmp" "$config_file"
    echo "✅ Budget disabled"
    exit 0
  fi

  # Set values
  if [[ -n "$limit" ]]; then
    jq ".budget.limit = $limit" "$config_file" > "$config_file.tmp" && mv "$config_file.tmp" "$config_file"
    echo "✅ Budget limit: \$$limit"
  fi

  if [[ -n "$period" ]]; then
    jq ".budget.period = \"$period\"" "$config_file" > "$config_file.tmp" && mv "$config_file.tmp" "$config_file"
    echo "✅ Budget period: $period"
  fi

  if [[ -n "$threshold" ]]; then
    jq ".budget.warning_threshold = $threshold" "$config_file" > "$config_file.tmp" && mv "$config_file.tmp" "$config_file"
    echo "✅ Warning threshold: $threshold"
  fi

  # Show status
  if [[ "$show_status" == "true" ]] || [[ -n "$limit" ]] || [[ -n "$period" ]]; then
    echo ""
    echo "═══ Budget Status ═══"
    local budget_enabled=$(jq -r '.budget.limit // empty' "$config_file")
    if [[ -z "$budget_enabled" ]]; then
      echo "Status: disabled"
      echo ""
      echo "To enable:"
      echo "  cwt budget --limit 10 --period daily"
    else
      echo "Limit:     \$$(jq -r '.budget.limit // 0' "$config_file")"
      echo "Period:    $(jq -r '.budget.period // "daily"' "$config_file")"
      echo "Threshold: $(jq -r '.budget.warning_threshold // 0.8' "$config_file")"

      # Show current spend if billing cache exists
      local billing_cache="$cwt_root/.cwt/billing-cache.json"
      if [[ -f "$billing_cache" ]]; then
        local current=$(jq -r '.cost // 0' "$billing_cache")
        local limit_val=$(jq -r '.budget.limit' "$config_file")
        echo "Current:   \$$current"
        echo "Remaining: \$$(echo "$limit_val - $current" | bc 2>/dev/null || echo "?")"
      fi
    fi
  fi
}

# Update command - update existing project with new version
cwt_update() {
  local cwt_root=$(find_cwt_root)
  local install_dir="$HOME/.claude-worktrees"

  if [[ -z "$cwt_root" ]]; then
    echo "❌ No CWT project found"
    echo "   Run 'cwt init' first"
    exit 1
  fi

  local session_name=$(get_session_name)
  local project_name="${session_name#cwt-}"

  echo "═══════════════════════════════════════"
  echo " CWT Update: $project_name"
  echo "═══════════════════════════════════════"

  # Check if there is an active session
  if tmux has-session -t "=$session_name" 2>/dev/null; then
    echo ""
    echo "⚠️  Session '$session_name' is active"
    echo "   To apply all changes, restart after the update:"
    echo "   cwt --kill && cwt -c"
    echo ""
    read -p "Continue with update? [Y/n] " -n 1 -r
    echo
    [[ $REPLY =~ ^[Nn]$ ]] && exit 0
  fi

  # Read config
  local config_file="$cwt_root/.cwt/config.json"
  local coordinator=$(jq -r '.coordinator // empty' "$config_file" 2>/dev/null)

  # Update coordinator
  if [[ -n "$coordinator" && -d "$cwt_root/$coordinator" ]]; then
    echo ""
    echo "📦 Coordinator: $coordinator"
    local claude_dir="$cwt_root/$coordinator/.claude"
    mkdir -p "$claude_dir"

    # CLAUDE.md
    if [[ -f "$install_dir/templates/CLAUDE.coord.md" ]]; then
      cp "$install_dir/templates/CLAUDE.coord.md" "$cwt_root/$coordinator/CLAUDE.md"
      echo "   ✅ CLAUDE.md updated"
    fi

    # settings.json (com MCP server configurado)
    if [[ -f "$install_dir/templates/settings.coord.json" ]]; then
      sed -e "s|CWT_ROOT_PLACEHOLDER|$cwt_root|g" \
          -e "s|~/.claude-worktrees|$install_dir|g" \
          "$install_dir/templates/settings.coord.json" > "$claude_dir/settings.json"
      echo "   ✅ settings.json updated (MCP: cwt)"
    fi

    # Symlinks for hooks
    ln -sf "$install_dir/hooks/wt-check.sh" "$claude_dir/wt-check.sh"
    ln -sf "$install_dir/hooks/wt-sync.sh" "$claude_dir/wt-sync.sh"
    echo "   ✅ hooks symlinks updated"

    # CWT Skills
    if [[ -d "$install_dir/templates/skills" ]]; then
      mkdir -p "$claude_dir/skills"
      for skill in cwt-coordinator cwt-kb cwt-budget; do
        if [[ -d "$install_dir/templates/skills/$skill" ]]; then
          cp -r "$install_dir/templates/skills/$skill" "$claude_dir/skills/"
        fi
      done
      echo "   ✅ skills updated (coordinator, kb, budget)"
    fi

    # Ensure .claude/ is in .gitignore (don't commit settings.json with local paths)
    local gitignore="$cwt_root/$coordinator/.gitignore"
    if [[ -f "$gitignore" ]]; then
      if ! grep -q "^\.claude/$" "$gitignore" 2>/dev/null; then
        echo ".claude/" >> "$gitignore"
        echo "   ✅ .claude/ added to .gitignore"
      fi
    else
      echo ".claude/" > "$gitignore"
      echo "   ✅ .gitignore created with .claude/"
    fi
  fi

  # Update workers
  # First try workers.txt, if empty detect automatically
  local workers_file="$cwt_root/.cwt/workers.txt"
  local workers_found=()

  # Read from workers.txt if it exists and is not empty
  if [[ -f "$workers_file" && -s "$workers_file" ]]; then
    while IFS= read -r worker_path; do
      [[ -n "$worker_path" && -d "$worker_path" ]] && workers_found+=("$worker_path")
    done < "$workers_file"
  fi

  # If no workers found in file, detect automatically
  if [[ ${#workers_found[@]} -eq 0 ]]; then
    echo ""
    echo "ℹ️  workers.txt empty, detecting worktrees automatically..."

    # Detect workspace-* directories in project
    for dir in "$cwt_root"/workspace-*; do
      [[ -d "$dir" ]] && workers_found+=("$dir")
    done

    # Detect git worktrees if coordinator is a repo
    if [[ -n "$coordinator" && -d "$cwt_root/$coordinator/.git" ]]; then
      while IFS= read -r wt_line; do
        local wt_path=$(echo "$wt_line" | awk '{print $1}')
        # Skip the coordinator itself
        [[ "$wt_path" != "$cwt_root/$coordinator" && -d "$wt_path" ]] && workers_found+=("$wt_path")
      done < <(git -C "$cwt_root/$coordinator" worktree list 2>/dev/null | tail -n +2)
    fi
  fi

  # Update each found worker
  for worker_path in "${workers_found[@]}"; do
    [[ ! -d "$worker_path" ]] && continue

    local worker_name=$(basename "$worker_path")
    echo ""
    echo "📦 Worker: $worker_name"
    local claude_dir="$worker_path/.claude"
    mkdir -p "$claude_dir"

    # CLAUDE.md com WORKER_ID correto
    if [[ -f "$install_dir/templates/CLAUDE.worker.md" ]]; then
      sed "s/WORKER_ID/$worker_name/g" "$install_dir/templates/CLAUDE.worker.md" > "$worker_path/CLAUDE.md"
      echo "   ✅ CLAUDE.md updated (WORKER_ID: $worker_name)"
    fi

    # settings.json com WORKER_ID e MCP server configurado
    if [[ -f "$install_dir/templates/settings.worker.json" ]]; then
      sed -e "s/WORKER_NAME/$worker_name/g" \
          -e "s|CWT_ROOT_PLACEHOLDER|$cwt_root|g" \
          -e "s|~/.claude-worktrees|$install_dir|g" \
          "$install_dir/templates/settings.worker.json" > "$claude_dir/settings.json"
      echo "   ✅ settings.json updated (MCP: cwt, WORKER_ID: $worker_name)"
    fi

    # Symlinks for hooks
    ln -sf "$install_dir/hooks/wt-check.sh" "$claude_dir/wt-check.sh"
    ln -sf "$install_dir/hooks/wt-sync.sh" "$claude_dir/wt-sync.sh"
    echo "   ✅ hooks symlinks updated"

    # CWT Skills
    if [[ -d "$install_dir/templates/skills" ]]; then
      mkdir -p "$claude_dir/skills"
      for skill in cwt-worker cwt-kb cwt-budget; do
        if [[ -d "$install_dir/templates/skills/$skill" ]]; then
          cp -r "$install_dir/templates/skills/$skill" "$claude_dir/skills/"
        fi
      done
      echo "   ✅ skills updated (worker, kb, budget)"
    fi

    # Ensure .claude/ is in .gitignore
    local gitignore="$worker_path/.gitignore"
    if [[ -f "$gitignore" ]]; then
      if ! grep -q "^\.claude/$" "$gitignore" 2>/dev/null; then
        echo ".claude/" >> "$gitignore"
        echo "   ✅ .claude/ added to .gitignore"
      fi
    elif [[ -d "$worker_path/.git" ]] || [[ -f "$worker_path/.git" ]]; then
      # Only create .gitignore if it's a git repo/worktree
      echo ".claude/" > "$gitignore"
      echo "   ✅ .gitignore created with .claude/"
    fi
  done

  if [[ ${#workers_found[@]} -eq 0 ]]; then
    echo ""
    echo "ℹ️  No workers found"
  fi

  # Sync Knowledge Base templates to global
  echo ""
  echo "📚 Syncing Knowledge Base..."

  local global_kb="$HOME/.cwt/knowledge"
  local templates_kb="$install_dir/templates/knowledge"

  if [[ -d "$templates_kb" ]]; then
    mkdir -p "$global_kb"

    # Copy templates that don't exist or are newer
    for category in patterns guidelines; do
      local src_dir="$templates_kb/$category"
      local dst_dir="$global_kb/$category"

      if [[ -d "$src_dir" ]]; then
        mkdir -p "$dst_dir"

        for file in "$src_dir"/*.md; do
          [[ -f "$file" ]] || continue
          local basename=$(basename "$file")
          local dst_file="$dst_dir/$basename"

          # Copy if doesn't exist or template is newer
          if [[ ! -f "$dst_file" ]] || [[ "$file" -nt "$dst_file" ]]; then
            cp "$file" "$dst_file"
            echo "   ✅ $category/$basename"
          fi
        done
      fi
    done

    # Copy index.json if it doesn't exist
    if [[ -f "$templates_kb/index.json" && ! -f "$global_kb/index.json" ]]; then
      cp "$templates_kb/index.json" "$global_kb/index.json"
      echo "   ✅ index.json"
    fi

    echo "   Global KB: $global_kb"
  else
    echo "   ℹ️  Templates not found in $templates_kb"
  fi

  echo ""
  echo "═══════════════════════════════════════"
  echo " ✅ Project updated"
  echo "═══════════════════════════════════════"
}

# Init command
cwt_init() {
  local project_name=""
  local coordinator=""
  local base_branch=""
  local force=false

  # Parse init args
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name|-n)
        project_name="$2"
        shift 2
        ;;
      --repo|-r)
        coordinator="$2"
        shift 2
        ;;
      --base|-b)
        base_branch="$2"
        shift 2
        ;;
      --force|-f)
        force=true
        shift
        ;;
      *)
        shift
        ;;
    esac
  done

  # Default: current directory name
  [[ -z "$project_name" ]] && project_name=$(basename "$PWD")

  # Check if already exists
  if [[ -d ".cwt" ]]; then
    echo "⚠️  CWT project already initialized in this directory"
    echo "   Config: .cwt/config.json"
    cat .cwt/config.json 2>/dev/null
    exit 1
  fi

  # If no coordinator specified, try to detect
  if [[ -z "$coordinator" ]]; then
    # Check if we are inside a git repo
    if git rev-parse --git-dir &>/dev/null; then
      # We are in a repo - use current directory name
      coordinator=$(basename "$PWD")
      echo "ℹ️  Detected git repo: $coordinator"
    fi
  fi

  # Detect base branch if not specified
  if [[ -z "$base_branch" ]]; then
    if git rev-parse --git-dir &>/dev/null; then
      base_branch=$(git branch --show-current)
    fi
  fi

  # Create work branch if we are in a repo
  local work_branch=""
  if git rev-parse --git-dir &>/dev/null; then
    work_branch="cwt/$project_name"

    # Check if repo has commits
    if ! git rev-parse HEAD &>/dev/null; then
      echo ""
      echo "ℹ️  Repo has no commits yet - branch protection disabled"
      work_branch="$base_branch"
    # Check if we are on a protected branch
    elif [[ "$base_branch" == "main" || "$base_branch" == "master" || "$base_branch" == "dev" || "$base_branch" == "develop" ]]; then
      if [[ "$force" != "true" ]]; then
        echo ""
        echo "⚠️  Branch '$base_branch' is protected."
        echo "   Creating work branch: $work_branch"
        echo ""

        # Create work branch if it doesn't exist
        if ! git show-ref --verify --quiet "refs/heads/$work_branch"; then
          if git branch "$work_branch" "$base_branch" 2>/dev/null; then
            echo "   ✅ Branch '$work_branch' created from '$base_branch'"
          else
            echo "   ❌ Failed to create branch '$work_branch'"
            work_branch="$base_branch"
          fi
        else
          echo "   ℹ️  Branch '$work_branch' already exists"
        fi

        # Checkout to work branch (only if created successfully)
        if [[ "$work_branch" != "$base_branch" ]] && git show-ref --verify --quiet "refs/heads/$work_branch"; then
          if git checkout "$work_branch" 2>/dev/null; then
            echo "   ✅ Checked out to '$work_branch'"
          else
            echo "   ❌ Failed to checkout '$work_branch'"
            work_branch="$base_branch"
          fi
        fi
      else
        echo "⚠️  --force: Working directly on '$base_branch'"
        work_branch="$base_branch"
      fi
    else
      work_branch="$base_branch"
    fi
  fi

  # Create structure
  mkdir -p .cwt

  cat > .cwt/config.json << EOF
{
  "name": "$project_name",
  "coordinator": "$coordinator",
  "base_branch": "$base_branch",
  "work_branch": "$work_branch",
  "created": "$(date -Iseconds)",
  "type": "project"
}
EOF

  echo '{"workers":{},"messages":[]}' > .cwt/state.json

  echo "═══════════════════════════════════════"
  echo " ✅ CWT project initialized"
  echo "═══════════════════════════════════════"
  echo " Name:    $project_name"
  echo " Session: cwt-$project_name"
  if [[ -n "$coordinator" ]]; then
    echo " Coord:   $coordinator"
  fi
  if [[ -n "$base_branch" ]]; then
    echo " Base:    $base_branch"
  fi
  if [[ -n "$work_branch" && "$work_branch" != "$base_branch" ]]; then
    echo " Work:    $work_branch"
  fi
  echo " Config:  .cwt/config.json"
  echo " State:   .cwt/state.json"
  echo "═══════════════════════════════════════"
  echo ""
  if [[ -z "$coordinator" ]]; then
    echo "Next steps:"
    echo "  1. Clone the repo: git clone <url> <name>"
    echo "  2. Configure:      cwt config --repo <name>"
    echo "  3. Worktrees:      cd <name> && wt-init worker1 worker2"
    echo "  4. Start:          cwt"
  else
    echo "Next steps:"
    echo "  1. Create worktrees: wt-init worker1 worker2"
    echo "  2. Start: cwt"
  fi
  echo ""
}

# Parse arguments
CONTINUE_FLAG=""
SOLO_MODE=""
STRICT_MODE=""
WORKERS=()

# First argument can be a command
case "${1:-}" in
  init)
    shift
    cwt_init "$@"
    exit 0
    ;;
  update)
    shift
    cwt_update "$@"
    exit 0
    ;;
  budget)
    shift
    cwt_budget "$@"
    exit 0
    ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      print_help
      exit 0
      ;;
    -v|--version)
      echo "CWT - Claude WorkTrees v$CWT_VERSION"
      echo "Install: $CWT_INSTALL_DIR"
      exit 0
      ;;
    -l|--list)
      echo "═══ Current project session ═══"
      tmux list-sessions 2>/dev/null | grep "^$SESSION_NAME" || echo "No active session for: $SESSION_NAME"
      exit 0
      ;;
    -a|--list-all)
      echo "═══ All CWT sessions ═══"
      tmux list-sessions 2>/dev/null | grep "^cwt" || echo "No active CWT sessions"
      exit 0
      ;;
    --daemon|-d)
      # Start only the MCP daemon (without tmux/workers)
      echo "═══ Starting MCP Daemon ═══"
      if [[ -S "$CWT_ROOT/.cwt/cwt.sock" ]]; then
        echo "Daemon already running: $CWT_ROOT/.cwt/cwt.sock"
        exit 0
      fi
      echo "Project: $CWT_ROOT"
      echo "Socket: $CWT_ROOT/.cwt/cwt.sock"
      echo ""
      node "$CWT_INSTALL_DIR/daemon/index.js" "$CWT_ROOT" &
      DAEMON_PID=$!
      sleep 1
      if [[ -S "$CWT_ROOT/.cwt/cwt.sock" ]]; then
        echo "MCP Daemon started (PID: $DAEMON_PID)"
        echo "Stop with: pkill -f 'daemon/index.js $CWT_ROOT'"
      else
        echo "Failed to start daemon"
        exit 1
      fi
      exit 0
      ;;
    --sessions)
      sessions_dir="$CWT_ROOT/.cwt/sessions"
      if [[ -d "$sessions_dir" ]]; then
        echo "═══ Saved sessions ═══"
        for f in "$sessions_dir"/*.json; do
          [[ -f "$f" ]] || continue
          name=$(basename "$f" .json)
          created=$(jq -r '.created // "?"' "$f" 2>/dev/null | cut -dT -f1)
          workers=$(jq -r '.sessions | keys | join(", ")' "$f" 2>/dev/null)
          echo "  $name ($created): $workers"
        done
      else
        echo "No saved sessions"
      fi
      exit 0
      ;;
    -k|--kill)
      if tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
        tmux kill-session -t "=$SESSION_NAME"
        echo "Session '$SESSION_NAME' killed"
      else
        echo "Session '$SESSION_NAME' does not exist"
      fi
      # Stop daemon and pulser
      if [[ -n "$CWT_ROOT" ]]; then
        for pid_file in "$CWT_ROOT/.cwt/daemon.pid" "$CWT_ROOT/.cwt/pulser.pid"; do
          if [[ -f "$pid_file" ]]; then
            pid=$(cat "$pid_file" 2>/dev/null)
            [[ -n "$pid" ]] && kill "$pid" 2>/dev/null
            rm -f "$pid_file"
          fi
        done
      fi
      exit 0
      ;;
    -s|--status)
      if tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
        echo "═══ CWT: $SESSION_NAME ═══"
        tmux list-windows -t "=$SESSION_NAME" -F "  #I: #W"
      else
        echo "Session '$SESSION_NAME' is not running"
      fi
      exit 0
      ;;
    -c|--continue)
      CONTINUE_FLAG="--continue"
      shift
      ;;
    -r|--resume)
      CONTINUE_FLAG="--resume"
      shift
      ;;
    -b|--base)
      export BASE_BRANCH="$2"
      shift 2
      ;;
    --solo)
      SOLO_MODE="true"
      shift
      ;;
    --strict)
      STRICT_MODE="true"
      shift
      ;;
    --session)
      CWT_SESSION_NAME="$2"
      shift 2
      ;;
    -*)
      echo "Unknown option: $1"
      echo "Use 'cwt --help' to see options"
      exit 1
      ;;
    *)
      WORKERS+=("$1")
      shift
      ;;
  esac
done

# If session exists and no workers were passed, reconnect
if tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
  # Refuse to touch a session that belongs to a different project (same
  # session name via an identical directory basename).
  SESSION_OWNER=$(tmux show-option -qv -t "=$SESSION_NAME" @cwt_root 2>/dev/null)
  CURRENT_ROOT=$(find_cwt_root)
  if [[ -n "$SESSION_OWNER" && -n "$CURRENT_ROOT" && "$SESSION_OWNER" != "$CURRENT_ROOT" ]]; then
    echo "❌ Session '$SESSION_NAME' belongs to another project:"
    echo "   $SESSION_OWNER"
    echo ""
    echo "   Give this project a distinct name:"
    echo "     cwt init --name <other-name>"
    exit 1
  fi

  if [[ ${#WORKERS[@]} -eq 0 ]]; then
    exec tmux attach -t "=$SESSION_NAME"
  else
    echo "Session '$SESSION_NAME' already exists."
    echo "Use: cwt --kill  to kill it"
    echo "Or:  cwt         to reconnect"
    exit 1
  fi
fi

# Start new session
export CONTINUE_FLAG
export SOLO_MODE
export STRICT_MODE
export SESSION_NAME
export CWT_SESSION_NAME
export CWT_PROJECT_ROOT=$(find_cwt_root)
exec "$CWT_DIR/tmux-launcher.sh" "${WORKERS[@]}"
