{
  "mcpServers": {
    "cwt": {
      "command": "node",
      "args": ["~/.claude-worktrees/daemon/mcp-server.js"],
      "env": {
        "CWT_PROJECT_ROOT": "CWT_ROOT_PLACEHOLDER",
        "CLAUDE_WORKER_ID": "coordinator"
      }
    }
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git worktree:*)",
      "Bash(git remote:*)",
      "Bash(git tag:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(echo:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(curl:*)",
      "Bash(wt-msg:*)",
      "Bash(wt-task:*)",
      "Bash(wt-sync:*)",
      "Bash(wt-check:*)",
      "Bash(azion:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git push)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-worktrees/hooks/bash-validator.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-worktrees/hooks/mark-compaction.sh 2>/dev/null || true",
            "timeout": 1000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-worktrees/hooks/wt-check.sh status 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-worktrees/hooks/wt-check.sh quick 2>/dev/null || true",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-worktrees/hooks/wt-check.sh quick 2>/dev/null || true",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-worktrees/hooks/wt-check.sh quick 2>/dev/null || true",
            "timeout": 3000
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_WORKER_ID": "coordinator"
  }
}
