{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git stash:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(echo:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(wt-msg:*)",
      "Bash(wt-task:*)",
      "Bash(wt-sync:*)",
      "Bash(wt-check:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git push)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout main)",
      "Bash(git checkout master)",
      "Bash(git checkout dev)",
      "Bash(git checkout develop)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "Bash(azion deploy:*)",
      "Bash(azion delete:*)",
      "Bash(azion create:*)",
      "Bash(azion update:*)",
      "Bash(azion link:*)",
      "Bash(azion unlink:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(killall:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-worktrees/hooks/bash-validator.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-worktrees/hooks/file-protector.sh",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-worktrees/hooks/file-protector.sh",
            "timeout": 3000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-worktrees/hooks/wt-check.sh status 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-worktrees/hooks/wt-check.sh quick 2>/dev/null || true",
            "timeout": 3000
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_WORKER_ID": "WORKER_NAME"
  }
}
