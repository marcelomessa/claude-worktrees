#!/bin/bash
# =============================================================================
# WT-TASK - Send tasks to workers
# =============================================================================
# Sends a task to a worker and optionally injects it into their tmux window.
#
# Usage:
#   wt-task <worker> "task description"
#   wt-task front "Implement login component"
#   wt-task --inject back "Fix API endpoint"
# =============================================================================

WORKER_ID="${CLAUDE_WORKER_ID:-coord}"

# Detectar .cwt/ subindo a árvore de diretórios
find_cwt_root() {
  # 1. Variável de ambiente
  if [[ -n "$CWT_PROJECT_ROOT" && -d "$CWT_PROJECT_ROOT/.cwt" ]]; then
    echo "$CWT_PROJECT_ROOT"
    return 0
  fi

  # 2. Subir árvore
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -d "$dir/.cwt" ]]; then
      echo "$dir"
      return 0
    fi
    dir=$(dirname "$dir")
  done

  return 1
}

# Determinar arquivo de estado e sessão
get_state_file() {
  local cwt_root=$(find_cwt_root)
  if [[ -n "$cwt_root" ]]; then
    echo "$cwt_root/.cwt/state.json"
  else
    echo "/tmp/claude-wt-state.json"
  fi
}

get_session_name() {
  local cwt_root=$(find_cwt_root)
  if [[ -n "$cwt_root" ]]; then
    local project_name=$(basename "$cwt_root")
    echo "cwt-$project_name"
  else
    echo "cwt"
  fi
}

get_tasks_dir() {
  local cwt_root=$(find_cwt_root)
  if [[ -n "$cwt_root" ]]; then
    echo "$cwt_root/.cwt/tasks"
  else
    echo "/tmp/claude-wt-tasks"
  fi
}

STATE_FILE=$(get_state_file)
SESSION_NAME=$(get_session_name)
TASKS_DIR=$(get_tasks_dir)

# Ensure tasks directory exists
mkdir -p "$TASKS_DIR"

# Initialize state file if needed
init_state() {
  [[ ! -f "$STATE_FILE" ]] && echo '{"workers":{},"messages":[],"tasks":{}}' > "$STATE_FILE"
}

show_help() {
  cat << 'EOF'
WT-TASK - Send tasks to workers

Usage: wt-task [OPTIONS] <worker> "task description"

Options:
  --inject, -i    Also inject task into worker's tmux window
  --list, -l      List pending tasks
  --clear         Clear completed tasks
  --help, -h      Show this help

Examples:
  wt-task front "Implement login component"
  wt-task --inject back "Fix the API endpoint"
  wt-task --list

Task files are stored in .cwt/tasks/ (or /tmp/claude-wt-tasks/ in legacy mode)
EOF
}

list_tasks() {
  echo "Pending tasks:"
  echo ""

  local found=false
  shopt -s nullglob
  for task_file in "$TASKS_DIR"/*.task; do
    if [[ -f "$task_file" ]]; then
      found=true
      worker=$(basename "$task_file" .task)
      echo "[$worker]"
      cat "$task_file"
      echo ""
    fi
  done
  shopt -u nullglob

  if [[ "$found" == "false" ]]; then
    echo "(no pending tasks)"
  fi
}

send_task() {
  local target="$1"
  local task="$2"
  local inject="$3"

  if [[ -z "$target" || -z "$task" ]]; then
    echo "Usage: wt-task <worker> \"task\""
    exit 1
  fi

  init_state

  local timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  local task_file="$TASKS_DIR/${target}.task"

  # Save task to file
  cat > "$task_file" << EOF
Task from: $WORKER_ID
Time: $timestamp

$task
EOF

  # Update state with task
  jq ".tasks[\"$target\"] = {\"from\":\"$WORKER_ID\",\"task\":\"$task\",\"timestamp\":\"$timestamp\",\"status\":\"pending\"}" \
    "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"

  # Send message
  jq ".messages += [{\"to\":\"$target\",\"from\":\"$WORKER_ID\",\"content\":\"[TASK] $task\",\"timestamp\":\"$timestamp\",\"read\":false}]" \
    "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"

  echo "Task sent to $target"
  echo "Session: $SESSION_NAME"
  echo "State: $STATE_FILE"

  # Inject into tmux if requested
  if [[ "$inject" == "true" ]]; then
    inject_task "$target" "$task"
  fi
}

inject_task() {
  local target="$1"
  local task="$2"

  # Check if session exists
  if ! tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "Warning: Session '$SESSION_NAME' not found"
    return 1
  fi

  # Find window by name
  local window_num=$(tmux list-windows -t "$SESSION_NAME" -F "#{window_index}:#{window_name}" 2>/dev/null | \
    grep ":$target$" | cut -d: -f1)

  if [[ -n "$window_num" ]]; then
    # Inject the task as input
    tmux send-keys -t "$SESSION_NAME:$window_num" "$task"
    sleep 0.1
    tmux send-keys -t "$SESSION_NAME:$window_num" "" C-m
    echo "Task injected into window $window_num ($target)"
  else
    echo "Warning: Could not find window for $target"
  fi
}

# Parse arguments
INJECT="false"
TARGET=""
TASK=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      show_help
      exit 0
      ;;
    --list|-l)
      list_tasks
      exit 0
      ;;
    --clear)
      rm -f "$TASKS_DIR"/*.task
      echo "Tasks cleared"
      exit 0
      ;;
    --inject|-i)
      INJECT="true"
      shift
      ;;
    -*)
      echo "Unknown option: $1"
      exit 1
      ;;
    *)
      if [[ -z "$TARGET" ]]; then
        TARGET="$1"
      else
        TASK="$1"
      fi
      shift
      ;;
  esac
done

if [[ -z "$TARGET" ]]; then
  show_help
  exit 1
fi

send_task "$TARGET" "$TASK" "$INJECT"
