#!/bin/bash
# =============================================================================
# WT-TASK - Send tasks to workers
# =============================================================================
# Sends a task to a worker and optionally injects it into their screen.
#
# Usage:
#   wt-task <worker> "task description"
#   wt-task front "Implement login component"
#   wt-task --inject back "Fix API endpoint"
# =============================================================================

STATE_FILE="/tmp/claude-wt-state.json"
TASKS_DIR="/tmp/claude-wt-tasks"
SESSION_NAME="claude-wt"
WORKER_ID="${CLAUDE_WORKER_ID:-coord}"

# Ensure tasks directory exists
mkdir -p "$TASKS_DIR"

# Initialize state file if needed
init_state() {
  [[ ! -f "$STATE_FILE" ]] && echo '{"workers":{},"messages":[],"tasks":{}}' > "$STATE_FILE"
}

show_help() {
  cat << 'EOF'
WT-TASK - Send tasks to workers

Usage: wt-task [OPTIONS] <worker> "task description"

Options:
  --inject, -i    Also inject task into worker's screen
  --list, -l      List pending tasks
  --clear         Clear completed tasks
  --help, -h      Show this help

Examples:
  wt-task front "Implement login component"
  wt-task --inject back "Fix the API endpoint"
  wt-task --list

Task files are stored in /tmp/claude-wt-tasks/
EOF
}

list_tasks() {
  echo "Pending tasks:"
  echo ""

  local found=false
  shopt -s nullglob
  for task_file in "$TASKS_DIR"/*.task; do
    if [[ -f "$task_file" ]]; then
      found=true
      worker=$(basename "$task_file" .task)
      echo "[$worker]"
      cat "$task_file"
      echo ""
    fi
  done
  shopt -u nullglob

  if [[ "$found" == "false" ]]; then
    echo "(no pending tasks)"
  fi
}

send_task() {
  local target="$1"
  local task="$2"
  local inject="$3"

  if [[ -z "$target" || -z "$task" ]]; then
    echo "Usage: wt-task <worker> \"task\""
    exit 1
  fi

  init_state

  local timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  local task_file="$TASKS_DIR/${target}.task"

  # Save task to file
  cat > "$task_file" << EOF
Task from: $WORKER_ID
Time: $timestamp

$task
EOF

  # Update state with task
  jq ".tasks[\"$target\"] = {\"from\":\"$WORKER_ID\",\"task\":\"$task\",\"timestamp\":\"$timestamp\",\"status\":\"pending\"}" \
    "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"

  # Send message
  jq ".messages += [{\"to\":\"$target\",\"from\":\"$WORKER_ID\",\"content\":\"[TASK] $task\",\"timestamp\":\"$timestamp\",\"read\":false}]" \
    "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"

  echo "Task sent to $target"

  # Inject into screen if requested
  if [[ "$inject" == "true" ]]; then
    inject_task "$target" "$task"
  fi
}

inject_task() {
  local target="$1"
  local task="$2"

  # Find window number for target
  local window_list=$(screen -S "$SESSION_NAME" -Q windows 2>/dev/null)

  # Try to find the window
  local window_num=""
  while IFS= read -r line; do
    if echo "$line" | grep -q "$target"; then
      window_num=$(echo "$line" | grep -o '^[0-9]*')
      break
    fi
  done <<< "$(screen -S "$SESSION_NAME" -Q windows 2>/dev/null | tr ' ' '\n')"

  if [[ -n "$window_num" ]]; then
    # Inject the task as input
    screen -S "$SESSION_NAME" -p "$window_num" -X stuff "$task"$'\n'
    echo "Task injected into window $window_num ($target)"
  else
    echo "Warning: Could not find window for $target"
  fi
}

# Parse arguments
INJECT="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      show_help
      exit 0
      ;;
    --list|-l)
      list_tasks
      exit 0
      ;;
    --clear)
      rm -f "$TASKS_DIR"/*.task
      echo "Tasks cleared"
      exit 0
      ;;
    --inject|-i)
      INJECT="true"
      shift
      ;;
    -*)
      echo "Unknown option: $1"
      exit 1
      ;;
    *)
      if [[ -z "$TARGET" ]]; then
        TARGET="$1"
      else
        TASK="$1"
      fi
      shift
      ;;
  esac
done

if [[ -z "$TARGET" ]]; then
  show_help
  exit 1
fi

send_task "$TARGET" "$TASK" "$INJECT"
