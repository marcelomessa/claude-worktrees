#!/bin/bash
# =============================================================================
# WT-INIT - Initialize worktrees for multi-agent Claude environment
# =============================================================================
# Creates git worktrees with branches and sets up CLAUDE.md templates
#
# Usage:
#   wt-init front back sec       # Create 3 worktrees
#   wt-init --base dev front     # Use dev as base branch
#   wt-init --prefix feature     # Use feature/ prefix (default)
# =============================================================================

set -e

WT_HOME="${WT_HOME:-$(dirname "$(dirname "$(realpath "$0")")")}"
TEMPLATES_DIR="$WT_HOME/templates"
INSTALL_DIR="$HOME/.claude-worktrees"

# Detect .cwt/ by walking up the directory tree
find_cwt_root() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -d "$dir/.cwt" ]]; then
      echo "$dir"
      return 0
    fi
    dir=$(dirname "$dir")
  done
  return 1
}

show_help() {
  cat << 'EOF'
WT-INIT - Initialize worktrees for multi-agent development

Usage: wt-init [OPTIONS] <worker1> [worker2] ...

Options:
  --help, -h        Show this help
  --base, -b BRANCH Base branch for worktrees (default: work_branch from config)
  --prefix, -p PRE  Branch prefix (default: cwt/<project> or feature)
  --dry-run         Show what would be done without doing it

Examples:
  wt-init front back sec           # Create 3 worktrees
  wt-init -b main ui api           # Base on main
  wt-init -p fix bug1 bug2         # Use fix/ prefix

Creates:
  - ../workspace-{name}/ directories
  - cwt/<project>/{name} branches (if in cwt project)
  - .claude/CLAUDE.md and settings.json in each worktree
EOF
}

# Defaults
BASE_BRANCH=""
PREFIX=""
DRY_RUN=false
WORKERS=()

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      show_help
      exit 0
      ;;
    --base|-b)
      BASE_BRANCH="$2"
      shift 2
      ;;
    --prefix|-p)
      PREFIX="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    -*)
      echo "Unknown option: $1"
      exit 1
      ;;
    *)
      WORKERS+=("$1")
      shift
      ;;
  esac
done

if [[ ${#WORKERS[@]} -eq 0 ]]; then
  show_help
  exit 1
fi

# Detect CWT project first (priority)
CWT_ROOT=$(find_cwt_root)
PROJECT_NAME=""
REPO_ROOT=""

if [[ -n "$CWT_ROOT" && -f "$CWT_ROOT/.cwt/config.json" ]]; then
  # CWT project mode: use coordinator from config
  PROJECT_NAME=$(jq -r '.name // empty' "$CWT_ROOT/.cwt/config.json" 2>/dev/null)
  COORDINATOR=$(jq -r '.coordinator // empty' "$CWT_ROOT/.cwt/config.json" 2>/dev/null)
  WORK_BRANCH=$(jq -r '.work_branch // empty' "$CWT_ROOT/.cwt/config.json" 2>/dev/null)

  if [[ -n "$COORDINATOR" ]]; then
    # Coordinator can be "." (project is the repo itself) or subdirectory
    if [[ "$COORDINATOR" == "." ]]; then
      REPO_ROOT="$CWT_ROOT"
    else
      REPO_ROOT="$CWT_ROOT/$COORDINATOR"
    fi
  fi

  # Use work_branch as base if not specified
  [[ -z "$BASE_BRANCH" && -n "$WORK_BRANCH" ]] && BASE_BRANCH="$WORK_BRANCH"

  # Use cwt/<project> as prefix if not specified
  [[ -z "$PREFIX" && -n "$PROJECT_NAME" ]] && PREFIX="cwt/$PROJECT_NAME"
fi

# Fallback: detect git repo directly
if [[ -z "$REPO_ROOT" ]]; then
  REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
fi

if [[ -z "$REPO_ROOT" || ! -d "$REPO_ROOT/.git" ]]; then
  echo "Error: Not in a git repository and no CWT project found"
  echo "  Run 'cwt init --repo <dir>' first, or cd into a git repo"
  exit 1
fi

PARENT_DIR=$(dirname "$REPO_ROOT")
CURRENT_BRANCH=$(git -C "$REPO_ROOT" branch --show-current)

# Defaults if project not detected
BASE_BRANCH="${BASE_BRANCH:-$CURRENT_BRANCH}"
PREFIX="${PREFIX:-feature}"

echo "╔═══════════════════════════════════════════════════════════════╗"
echo "║         WT-INIT - Create Multi-Agent Worktrees                ║"
echo "╚═══════════════════════════════════════════════════════════════╝"
echo ""
echo "  Repository: $(basename "$REPO_ROOT")"
echo "  Base branch: $BASE_BRANCH"
echo "  Prefix: $PREFIX/"
echo "  Workers: ${WORKERS[*]}"
echo ""

if [[ "$DRY_RUN" == "true" ]]; then
  echo "[DRY RUN] Would create:"
fi

for worker in "${WORKERS[@]}"; do
  BRANCH_NAME="$PREFIX/$worker"
  WORKTREE_PATH="$PARENT_DIR/workspace-$worker"

  echo "─────────────────────────────────────────────────────────────────"
  echo "  Worker: $worker"
  echo "  Branch: $BRANCH_NAME"
  echo "  Path:   $WORKTREE_PATH"

  if [[ "$DRY_RUN" == "true" ]]; then
    continue
  fi

  # Check if worktree already exists
  if [[ -d "$WORKTREE_PATH" ]]; then
    echo "  ⚠️  Worktree already exists, skipping"
    continue
  fi

  # Check if branch exists
  if git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH_NAME"; then
    echo "  Branch exists, creating worktree..."
    git -C "$REPO_ROOT" worktree add "$WORKTREE_PATH" "$BRANCH_NAME"
  else
    echo "  Creating branch and worktree..."
    git -C "$REPO_ROOT" worktree add -b "$BRANCH_NAME" "$WORKTREE_PATH" "$BASE_BRANCH"
  fi

  # Setup .claude/
  CLAUDE_DIR="$WORKTREE_PATH/.claude"
  mkdir -p "$CLAUDE_DIR"

  # CLAUDE.md
  if [[ -f "$TEMPLATES_DIR/CLAUDE.worker.md" ]]; then
    sed "s/WORKER_ID/$worker/g" "$TEMPLATES_DIR/CLAUDE.worker.md" > "$CLAUDE_DIR/CLAUDE.md"
    echo "  ✓ CLAUDE.md"
  fi

  # settings.json with correct replacements
  if [[ -f "$INSTALL_DIR/templates/settings.worker.json" ]]; then
    # Replace: WORKER_NAME, CWT_ROOT_PLACEHOLDER, ~/
    sed -e "s/WORKER_NAME/$worker/g" \
        -e "s|CWT_ROOT_PLACEHOLDER|${CWT_ROOT:-$PARENT_DIR}|g" \
        -e "s|~/.claude-worktrees|$INSTALL_DIR|g" \
        "$INSTALL_DIR/templates/settings.worker.json" > "$CLAUDE_DIR/settings.json"
    echo "  ✓ settings.json"
  fi

  # Symlinks for hooks
  if [[ -d "$INSTALL_DIR/hooks" ]]; then
    ln -sf "$INSTALL_DIR/hooks/wt-check.sh" "$CLAUDE_DIR/wt-check.sh"
    ln -sf "$INSTALL_DIR/hooks/wt-sync.sh" "$CLAUDE_DIR/wt-sync.sh"
    echo "  ✓ hooks symlinks"
  fi

  # Skills
  if [[ -d "$INSTALL_DIR/templates/skills" ]]; then
    mkdir -p "$CLAUDE_DIR/skills"
    for skill in cwt-worker cwt-kb cwt-budget; do
      if [[ -d "$INSTALL_DIR/templates/skills/$skill" ]]; then
        cp -r "$INSTALL_DIR/templates/skills/$skill" "$CLAUDE_DIR/skills/"
      fi
    done
    echo "  ✓ skills"
  fi

  # Register in project's workers.txt
  if [[ -n "$CWT_ROOT" ]]; then
    echo "$WORKTREE_PATH" >> "$CWT_ROOT/.cwt/workers.txt"
  fi

  echo "  ✅ Done"
done

echo ""
echo "═══════════════════════════════════════════════════════════════"

# Show worktree list
echo ""
echo "Current worktrees:"
git -C "$REPO_ROOT" worktree list

echo ""
echo "Start with: cwt ${WORKERS[*]}"
