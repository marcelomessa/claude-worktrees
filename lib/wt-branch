#!/bin/bash
# =============================================================================
# WT-BRANCH - Branch synchronization and status for CWT
# =============================================================================
# Shows branch status of all workers and helps with synchronization.
#
# Usage:
#   wt-branch [status]     Show branch status of all workers
#   wt-branch sync         Fetch and show divergence
#   wt-branch check        Quick check (for startup/hooks)
# =============================================================================

# Detect .cwt/ by walking up the directory tree
find_cwt_root() {
  if [[ -n "$CWT_PROJECT_ROOT" && -d "$CWT_PROJECT_ROOT/.cwt" ]]; then
    echo "$CWT_PROJECT_ROOT"
    return 0
  fi

  local dir="$PWD"
  while [[ "$dir" != "/" && "$dir" != "$HOME" ]]; do
    if [[ -d "$dir/.cwt" ]]; then
      echo "$dir"
      return 0
    fi
    dir=$(dirname "$dir")
  done

  return 1
}

CWT_ROOT=$(find_cwt_root)
if [[ -z "$CWT_ROOT" ]]; then
  echo "Error: Not in a CWT project"
  exit 1
fi

WORKERS_FILE="$CWT_ROOT/.cwt/workers.txt"

# Detect coordinator
detect_coordinator() {
  if [[ -f "$CWT_ROOT/.cwt/config.json" ]]; then
    local coord=$(jq -r '.coordinator // empty' "$CWT_ROOT/.cwt/config.json" 2>/dev/null)
    if [[ -n "$coord" && "$coord" != "null" ]]; then
      if [[ -d "$CWT_ROOT/$coord" ]]; then
        echo "$CWT_ROOT/$coord"
        return
      fi
    fi
  fi

  # Is PROJECT_ROOT the repo itself?
  if [[ -d "$CWT_ROOT/.git" ]]; then
    echo "$CWT_ROOT"
    return
  fi

  # First folder with full .git/
  for dir in "$CWT_ROOT"/*/; do
    local name=$(basename "$dir")
    [[ "$name" == ".cwt" ]] && continue
    if [[ -d "$dir/.git" ]]; then
      echo "$dir"
      return
    fi
  done
}

# Get workers
get_workers() {
  if [[ -f "$WORKERS_FILE" ]]; then
    while IFS= read -r line; do
      [[ -n "$line" ]] && echo "$line"
    done < "$WORKERS_FILE"
  fi

  # Also detect git worktrees
  local coord=$(detect_coordinator)
  if [[ -n "$coord" ]]; then
    git -C "$coord" worktree list --porcelain 2>/dev/null | grep "^worktree " | cut -d' ' -f2- | while read -r wt_path; do
      [[ "$wt_path" == "$coord" ]] && continue
      basename "$wt_path"
    done
  fi
}

# Format branch status
format_status() {
  local dir="$1"
  local name="$2"

  if [[ ! -d "$dir" ]]; then
    printf "   %-15s ❌ not found\n" "$name:"
    return
  fi

  local branch=$(git -C "$dir" branch --show-current 2>/dev/null || echo "?")
  local status=""
  local dirty=""
  local ahead=""
  local behind=""

  # Check dirty
  if ! git -C "$dir" diff --quiet 2>/dev/null; then
    dirty="📝"
  fi
  if ! git -C "$dir" diff --staged --quiet 2>/dev/null; then
    dirty="${dirty}📦"
  fi

  # Check ahead/behind
  local tracking=$(git -C "$dir" rev-parse --abbrev-ref --symbolic-full-name "@{u}" 2>/dev/null)
  if [[ -n "$tracking" ]]; then
    local counts=$(git -C "$dir" rev-list --left-right --count "$tracking...HEAD" 2>/dev/null)
    behind=$(echo "$counts" | cut -f1)
    ahead=$(echo "$counts" | cut -f2)

    [[ "$ahead" -gt 0 ]] && status="↑$ahead"
    [[ "$behind" -gt 0 ]] && status="${status}↓$behind"
  fi

  # Format output
  if [[ -n "$dirty" || -n "$status" ]]; then
    printf "   %-15s %-20s %s %s\n" "$name:" "$branch" "${dirty:-·}" "${status:-·}"
  else
    printf "   %-15s %-20s ✓\n" "$name:" "$branch"
  fi
}

# Command: status (default)
cmd_status() {
  echo "📊 Branch Status"
  echo ""

  # Coordinator
  local coord=$(detect_coordinator)
  if [[ -n "$coord" ]]; then
    echo "🎯 Coordinator:"
    format_status "$coord" "$(basename "$coord")"
  fi

  echo ""
  echo "👷 Workers:"

  # Workers
  local workers=($(get_workers | sort -u))
  if [[ ${#workers[@]} -eq 0 ]]; then
    echo "   (no workers)"
    return
  fi

  for worker in "${workers[@]}"; do
    local worker_dir=""

    # Try to find directory
    if [[ -d "$CWT_ROOT/$worker" ]]; then
      worker_dir="$CWT_ROOT/$worker"
    elif [[ -d "$CWT_ROOT/workspace-$worker" ]]; then
      worker_dir="$CWT_ROOT/workspace-$worker"
    else
      # Search in worktrees
      local coord=$(detect_coordinator)
      if [[ -n "$coord" ]]; then
        worker_dir=$(git -C "$coord" worktree list --porcelain 2>/dev/null | grep "^worktree " | cut -d' ' -f2- | while read -r wt; do
          if [[ "$(basename "$wt")" == "$worker" || "$(basename "$wt")" == "workspace-$worker" ]]; then
            echo "$wt"
            break
          fi
        done)
      fi
    fi

    format_status "$worker_dir" "$worker"
  done

  echo ""
  echo "Legend: 📝=modified 📦=staged ↑=ahead ↓=behind ✓=synchronized"
}

# Command: sync - fetch and show divergence
cmd_sync() {
  echo "🔄 Syncing branches..."
  echo ""

  # Coordinator
  local coord=$(detect_coordinator)
  if [[ -n "$coord" ]]; then
    echo "🎯 Coordinator: $(basename "$coord")"
    git -C "$coord" fetch --quiet 2>/dev/null && echo "   ✓ fetch" || echo "   ⚠ fetch failed"
  fi

  # Workers
  local workers=($(get_workers | sort -u))
  for worker in "${workers[@]}"; do
    local worker_dir=""

    if [[ -d "$CWT_ROOT/$worker" ]]; then
      worker_dir="$CWT_ROOT/$worker"
    elif [[ -d "$CWT_ROOT/workspace-$worker" ]]; then
      worker_dir="$CWT_ROOT/workspace-$worker"
    fi

    if [[ -d "$worker_dir" ]]; then
      echo "👷 $worker:"
      git -C "$worker_dir" fetch --quiet 2>/dev/null && echo "   ✓ fetch" || echo "   ⚠ fetch failed"
    fi
  done

  echo ""
  cmd_status
}

# Command: check - compact output for hooks/startup
cmd_check() {
  local issues=()

  # Check coordinator
  local coord=$(detect_coordinator)
  if [[ -n "$coord" ]]; then
    if ! git -C "$coord" diff --quiet 2>/dev/null; then
      issues+=("coordinator:dirty")
    fi
    local tracking=$(git -C "$coord" rev-parse --abbrev-ref --symbolic-full-name "@{u}" 2>/dev/null)
    if [[ -n "$tracking" ]]; then
      local counts=$(git -C "$coord" rev-list --left-right --count "$tracking...HEAD" 2>/dev/null)
      local behind=$(echo "$counts" | cut -f1)
      [[ "$behind" -gt 0 ]] && issues+=("coordinator:behind($behind)")
    fi
  fi

  # Check workers
  local workers=($(get_workers | sort -u))
  for worker in "${workers[@]}"; do
    local worker_dir=""
    if [[ -d "$CWT_ROOT/$worker" ]]; then
      worker_dir="$CWT_ROOT/$worker"
    elif [[ -d "$CWT_ROOT/workspace-$worker" ]]; then
      worker_dir="$CWT_ROOT/workspace-$worker"
    fi

    if [[ -d "$worker_dir" ]]; then
      if ! git -C "$worker_dir" diff --quiet 2>/dev/null; then
        issues+=("$worker:dirty")
      fi
      local tracking=$(git -C "$worker_dir" rev-parse --abbrev-ref --symbolic-full-name "@{u}" 2>/dev/null)
      if [[ -n "$tracking" ]]; then
        local counts=$(git -C "$worker_dir" rev-list --left-right --count "$tracking...HEAD" 2>/dev/null)
        local behind=$(echo "$counts" | cut -f1)
        [[ "$behind" -gt 0 ]] && issues+=("$worker:behind($behind)")
      fi
    fi
  done

  if [[ ${#issues[@]} -gt 0 ]]; then
    echo "⚠️  Branch issues: ${issues[*]}"
    return 1
  else
    echo "✓ Branches synchronized"
    return 0
  fi
}

# Help
show_help() {
  cat << 'EOF'
WT-BRANCH - Branch synchronization for CWT

Usage: wt-branch [COMMAND]

Commands:
  status    Show branch status of all workers (default)
  sync      Fetch and show divergence
  check     Quick check for startup/hooks (compact output)

Status symbols:
  📝  Uncommitted changes
  📦  Staged changes
  ↑N  N commits ahead of remote
  ↓N  N commits behind remote
  ✓   Clean and synchronized

Examples:
  wt-branch              Show status
  wt-branch sync         Fetch all and show status
  wt-branch check        Quick check (returns exit code)
EOF
}

# Main
case "${1:-status}" in
  status)
    cmd_status
    ;;
  sync)
    cmd_sync
    ;;
  check)
    cmd_check
    ;;
  -h|--help|help)
    show_help
    ;;
  *)
    echo "Unknown command: $1"
    show_help
    exit 1
    ;;
esac
